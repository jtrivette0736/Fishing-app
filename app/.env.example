# Copy to .env.local for local development. Vite exposes only VITE_* variables to the browser.
# Leave VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY empty to run in demo mode (no back end).

# Supabase project (Project settings -> API). The anon key is public by design; RLS protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where this app is served (used for auth redirects and absolute links).
VITE_APP_URL=http://localhost:5173

# Optional: Cloudflare Turnstile site key for the public intake form (the secret stays server-side).
VITE_TURNSTILE_SITE_KEY=

# Never put the Supabase service-role key, Stripe secret key or Resend API key here:
# they belong in Supabase Edge Function secrets, not in the browser bundle or Netlify build env.
