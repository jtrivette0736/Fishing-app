{
  "name": "fishing-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Job tracking for small fishing-gear service businesses (reel techs, rod builders).",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:sql": "bash supabase/tests/run.sh",
    "db:types": "bash supabase/tests/run.sh --keep && npx supabase@2 gen types typescript --db-url \"$npm_package_config_harness_db_url\" --schema public > src/lib/supabase/types.generated.ts && node scripts/finish-types.mjs; bash supabase/tests/run.sh --stop",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "config": {
    "harness_db_url": "postgresql://postgres:postgres@127.0.0.1:54329/postgres"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
